# ==============================================================================
# MediApp Environment Configuration
# ==============================================================================

# Application Environment: development | production | testing
APP_ENV=development

# Operational Mode: demo | real
# - In 'demo' mode:
#   * Safe local simulated payments (no real charges, test transaction reference)
#   * Labelled AI fallback responses when GEMINI_API_KEY is not set
#   * Local prescription OCR parser with deterministic candidate extraction
#   * Quick demo 1-click logins for Customer, Pharmacy, Delivery, and Admin
# - In 'real' mode:
#   * Razorpay live/test order creation and HMAC verification required
#   * Gemini API key required for live AI Ailment Assistant
#   * Google OAuth 2.0 required for Google login
APP_MODE=demo

# Server Port and Host
PORT=5000
HOST=127.0.0.1

# Flask Secret Key for Session Signing (Generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=dev_secret_key_change_in_production_8941fba0e3d

# Database Configuration (Relative path from project root or absolute SQLite path)
DATABASE_PATH=mediapp.db

# File Uploads
UPLOAD_FOLDER=uploads/prescriptions
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Configuration (Required only when APP_MODE=real for Google Auth)
# Setup in Google Cloud Console -> APIs & Services -> Credentials:
# Authorized redirect URI: http://127.0.0.1:5000/api/auth/google/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/api/auth/google/callback

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Required only when APP_MODE=real for payments)
# Obtain from https://dashboard.razorpay.com/#/app/keys (Test or Live key)
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------------------------------------------
# Google Gemini API (Required only when APP_MODE=real for AI Ailment Assistant)
# Obtain from https://aistudio.google.com/
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# Optional Tesseract OCR path on Windows (Leave blank if not installed)
# ------------------------------------------------------------------------------
TESSERACT_CMD=
